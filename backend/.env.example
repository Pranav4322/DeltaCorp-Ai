# Copy this file to .env and fill in your key(s).
#
# Multi-provider fallback: at least one of the three keys below must be
# set. If more than one is set, they're tried in this order per call —
# Anthropic -> Gemini -> OpenRouter — and if one fails (bad key, rate
# limit, outage), the next configured one is used automatically. See
# src/llm.js.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-latest

# Server port
PORT=3000

# How often the scheduler "ticks" to consider publishing (cron syntax).
# Default: every 20 minutes. The tick itself decides whether to actually
# publish (randomized cadence + editorial judgment), it does not publish
# on every tick.
SCHEDULE_CRON=*/20 * * * *

# Min/max minutes to wait between actual publishes (jittered autonomy)
MIN_GAP_MINUTES=90
MAX_GAP_MINUTES=240

# Curator rejection threshold (0-10 scale, weighted average)
PUBLISH_SCORE_THRESHOLD=6.5

# Min/max minutes between Auditor re-check attempts (jittered, independent
# of the publish cadence above). The Auditor only actually does anything
# when a claim's own check_after has come due — see src/pipeline/auditor.js.
MIN_AUDIT_GAP_MINUTES=60
MAX_AUDIT_GAP_MINUTES=150
